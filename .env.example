# ==============================================================================
# TUST-iMaker LeRobot Workspace — Cross-OS Environment Variables Example
# Copy to `.env` (gitignored) and adjust ports/tokens for your machine.
# Do NOT commit real HF_TOKEN or WANDB_API_KEY values.
# ==============================================================================

# --- Workspace & Virtualenv Paths ---
# Leave LEROBOT_WORKSPACE_ROOT empty to auto-detect from repo root
LEROBOT_WORKSPACE_ROOT=
LEROBOT_WIN_VENV=envs/win/lerobot
LEROBOT_UBUNTU_VENV=$HOME/.venvs/tust-lerobot
OPENPI_UBUNTU_VENV=$HOME/.venvs/tust-openpi

# --- Hugging Face & OpenPI Cache / Auth ---
HF_LEROBOT_HOME=./data
# HF_HOME=~/.cache/huggingface
HF_ENDPOINT=https://huggingface.co
# China mirror option: HF_ENDPOINT=https://hf-mirror.com
HF_TOKEN=
# OPENPI_DATA_HOME=~/.cache/openpi
WANDB_API_KEY=

# --- Official arm101 (SO-ARM101) Serial Ports & IDs ---
# Windows Device Manager COM ports (discover via scripts/windows/find_ports.ps1)
ARM101_FOLLOWER_PORT_WIN=COM3
ARM101_LEADER_PORT_WIN=COM4

# Ubuntu / WSL2 USB-ACM ports or udev symlinks (discover via lerobot-find-port)
ARM101_FOLLOWER_PORT_UBUNTU=/dev/ttyACM0
ARM101_LEADER_PORT_UBUNTU=/dev/ttyACM1

# Calibration profile IDs (stored under data/calibration/)
ARM101_FOLLOWER_ID=arm101_follower_01
ARM101_LEADER_ID=arm101_leader_01

# Camera device indices or V4L2 paths
ARM101_FRONT_CAMERA_ID=0
ARM101_WRIST_CAMERA_ID=1

# --- Local Arm101 Studio (`app/`) Settings ---
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8760
# auto | real | dry_run
STUDIO_MODE=auto
